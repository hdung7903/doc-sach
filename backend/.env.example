APP_NAME=DocSach
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=doc_sach
DB_USERNAME=postgres
DB_PASSWORD=postgres

QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

CACHE_STORE=database
